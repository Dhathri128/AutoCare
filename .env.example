SECRET_KEY=change-this-to-a-long-random-value

# Local development fallback:
DATABASE_URL=sqlite:///autocare.db

# Supabase PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Storage bucket used by AutoCare for generated invoices
SUPABASE_STORAGE_BUCKET=invoices
